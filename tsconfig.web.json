{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "next/link": ["./src/renderer/src/shims/nextLink.tsx"],
      "next/navigation": ["./src/renderer/src/shims/nextNavigation.tsx"],
      "next/image": ["./src/renderer/src/shims/nextImage.tsx"],
      "@/lib/supabase/client": ["./src/renderer/src/shims/supabaseClient.ts"],
      "@uiw/react-codemirror": ["./src/renderer/src/shims/codemirror.tsx"],
      "@codemirror/lang-python": ["./src/renderer/src/shims/langPython.ts"],
      "~/*": ["./src/renderer/src/*"],
      "@/*": ["./src/renderer/src/web/*"],
      "@shared/*": ["./src/shared/*"]
    }
  },
  "include": ["src/renderer/src/**/*", "src/shared/**/*"],
  "exclude": ["src/renderer/src/web/**/*"]
}
