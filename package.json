{
  "name": "parasync-desktop",
  "productName": "Parasync",
  "version": "0.4.0",
  "description": "Parasync for Windows",
  "author": "Parasync Technologies Pvt Ltd",
  "homepage": "https://github.com/edureyalabs/parasync_desktop",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "sync-web": "node --no-warnings scripts/sync-web.ts",
    "test": "rolldown scripts/tests/executor.test.ts --format esm --platform node --file out/test/executor.test.mjs && node --no-warnings --test out/test/executor.test.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json && tsc --noEmit -p tsconfig.web-mirror.json",
    "dist": "npm run build && electron-builder --win --publish never",
    "release:patch": "npm version patch -m \"Release %s\"",
    "release:minor": "npm version minor -m \"Release %s\""
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  },
  "devDependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/newsreader": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "45.0.0",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
