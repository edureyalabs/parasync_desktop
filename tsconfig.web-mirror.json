{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "noImplicitReturns": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "noEmit": true,
    "paths": {
      "next/link": [
        "./src/renderer/src/shims/nextLink.tsx"
      ],
      "next/navigation": [
        "./src/renderer/src/shims/nextNavigation.tsx"
      ],
      "next/image": [
        "./src/renderer/src/shims/nextImage.tsx"
      ],
      "@/lib/supabase/client": [
        "./src/renderer/src/shims/supabaseClient.ts"
      ],
      "@/components/local-copy/LocalCopy": [
        "./src/renderer/src/shims/localCopy.tsx"
      ],
      "@uiw/react-codemirror": [
        "./src/renderer/src/shims/codemirror.tsx"
      ],
      "@codemirror/lang-python": [
        "./src/renderer/src/shims/langPython.ts"
      ],
      "~/*": [
        "./src/renderer/src/*"
      ],
      "@/*": [
        "./src/renderer/src/web/*"
      ],
      "@shared/*": [
        "./src/shared/*"
      ]
    }
  },
  "include": [
    "src/renderer/src/web/**/*",
    "src/renderer/src/shims/**/*",
    "src/renderer/src/global.d.ts",
    "src/shared/**/*"
  ]
}
